{
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "nerds-room.vercel.app"
                }
            ],
            "destination": "https://www.nerdsroom.org/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/luma/:match*",
            "destination": "https://api.lu.ma/:match*"
        },
        {
            "source": "/((?!robots.txt|sitemap.xml|favicon.ico|og-image.png|logo.png|assets|api/).*)",
            "destination": "/index.html"
        }
    ]
}